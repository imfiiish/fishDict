# Copy to .env (gitignored) and adjust for your machine.

# Directory holding per-language pronunciation audio folders, e.g.
#   $AUDIO_DIR/ko/17287_ga-ge.wav  ->  GET /audio/ko/17287_ga-ge.wav
# A relative path is resolved against the repo root. Default: ./audio
AUDIO_DIR=/absolute/path/to/audio

# PostgreSQL connection. Defaults to the docker compose service.
# DATABASE_URL=postgres://fishdict:fishdict@localhost:5432/fishdict
